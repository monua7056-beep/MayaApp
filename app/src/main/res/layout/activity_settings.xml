<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Settings"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- API Key Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 Gemini API Key"
            android:textColor="#9D7BFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maya को natural language समझने के लिए Gemini API key चाहिए।"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="यहाँ API key paste करो"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="#1A1A2E"
            android:padding="14dp"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/saveKeyBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Key"
            android:backgroundTint="#6C5CE7"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/keyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API key कैसे लें?\n1. https://aistudio.google.com/app/apikey खोलो\n2. 'Create API Key' दबाओ\n3. Copy करके ऊपर paste करो"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="24dp"/>

        <!-- Accessibility Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♿ Accessibility Service"
            android:textColor="#9D7BFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen पढ़ने और apps control करने के लिए ज़रूरी है।"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♿ Accessibility Settings खोलो"
            android:backgroundTint="#6C5CE7"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ Maya v2 — AI Voice Assistant"
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
